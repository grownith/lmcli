{
  "name": "lmcli",
  "displayName": "lmcli",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "enabledApiProposals": [
    "chatProvider"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguageModelChatProvider:lmcli"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [],
    "languageModelChatProviders": [
      {
        "vendor": "lmcli",
        "displayName": "Claude CLI",
        "description": "Use the local Claude CLI as a language model chat provider.",
        "default": true
      }
    ],
    "configuration": {
      "type": "object",
      "title": "lmcli",
      "properties": {
        "lmcli.claudeCliPath": {
          "type": "string",
          "default": "claude",
          "description": "Path to the Claude CLI executable."
        },
        "lmcli.claudeCliArgs": {
          "type": "string",
          "default": "",
          "description": "Extra arguments to pass to the Claude CLI. Use {{prompt}} to insert the prompt."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3"
  },
  "dependencies": {
    "@streamparser/json-node": "^0.0.22",
    "execa": "^9.6.1",
    "rxjs": "^7.8.2"
  }
}
