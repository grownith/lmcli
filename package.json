{
  "name": "lmcli",
  "displayName": "lmcli",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [{
      "command": "lmcli.helloWorld",
      "title": "Hello World"
    }],
    "languageModelChatProviders": [
      {
        "vendor": "lmcli",
        "displayName": "Claude CLI",
        "description": "Use the local Claude CLI as a language model chat provider.",
        "default": true
      }
    ],
    "configuration": {
      "type": "object",
      "title": "lmcli",
      "properties": {
        "lmcli.claudeCliPath": {
          "type": "string",
          "default": "claude",
          "description": "Path to the Claude CLI executable."
        },
        "lmcli.claudeCliArgs": {
          "type": "string",
          "default": "",
          "description": "Extra arguments to pass to the Claude CLI. Use {{prompt}} to insert the prompt."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.39.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
